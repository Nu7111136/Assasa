# Rakhza secrets. Copy to secrets/rakhza.env, fill in, then:
#   python scripts/vault.py lock
# Lines before the STAGING marker apply to both environments.

# Used by Let's Encrypt on the VPS (Caddy).
CADDY_EMAIL=

# Postgres + Redis on the VPS (shared server, two databases).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# JazzCash Business wallet number shops send Rs 299 to (TID flow).
# This is NOT Payment Gateway. A business account does not include Merchant ID.
PAYMENT_JAZZCASH_NUMBER=

# JazzCash Payment Gateway — only if JazzCash issued these (Merchant ID starts with MC).
# Leave blank to keep manual TID review. Do not expect sandbox to work.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# Voice (optional, free first). Groq Whisper + Llama. Leave blank to hide the mic.
GROQ_API_KEY=
# Later paid path. Leave blank until you want to pay OpenAI.
OPENAI_API_KEY=

# ===== STAGING =====
APP_ENV=staging
SECRET_KEY=
COOKIE_SECURE=1
LOG_LEVEL=DEBUG
ADMIN_PHONES=
TESTER_PHONES=
JAZZCASH_ENV=sandbox

# ===== PRODUCTION =====
APP_ENV=production
SECRET_KEY=
COOKIE_SECURE=1
LOG_LEVEL=INFO
ADMIN_PHONES=
TESTER_PHONES=
JAZZCASH_ENV=live
