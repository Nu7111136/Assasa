# Generate your own random key; never commit a real key.
SECRET_KEY=
# Empty/unset DATABASE_URL uses SQLite in instance/asasa.db (development only).
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
COOKIE_SECURE=0
# Set COOKIE_SECURE=1 on HTTPS production.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

APP_ENV=production
# JazzCash Business receive number. Set only here and in the host env, never in Git.
PAYMENT_JAZZCASH_NUMBER=
# Comma-separated, registered phone numbers. Empty = no admin access.
ADMIN_PHONES=
# Tester Next day / Reset buttons (works in production too); admin phones also qualify.
TESTER_PHONES=
